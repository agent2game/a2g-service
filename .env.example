# Copy to .env and fill in. The real process environment overrides these values.
OPENAI_API_KEY=
# A2G_PROVIDER=openai   # decider: openai (OpenAI Decisions) or jev (TypeSafe Jev, needs TYPESAFE_API_KEY)
# TYPESAFE_API_KEY=
# A2G_ALLOWED_ORIGINS=http://localhost:5173   # browser games on local dev servers: exact loopback origins, comma-separated, protocol routes only
# A2G_PROVIDER_CALLS=16  # concurrent provider calls; extra batches fall back with code busy
# A2G_CONSOLE=on        # off: headless service (protocol routes and /health only, no Agent2Game Console)
# Optional
# A2G_PORT=8787         # listen port (also the published port in docker compose)
# A2G_DB=./a2g.db       # SQLite file; Docker uses /data/a2g.db in the a2g-data volume
